---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

// Get all pages from the page collection
export async function getStaticPaths() {
  const pageEntries = await getCollection("page");
  return pageEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base postData={entry}>
  <article class="px-7 pt-10 mx-auto w-full">
    <div class="mx-auto prose lg:prose-xl">
      <h1 class="transition-all duration-300 dark:text-white">
        {entry.data.title}
      </h1>
      <div class="prose lg:prose-xl dark:prose-invert">
        <Content />
      </div>
    </div>
  </article>
</Base>
