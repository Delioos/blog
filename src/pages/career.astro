---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const careers = (await getCollection('career')).sort(
    (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);

const formatDate = (date: Date) => {
    return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};
---

<Base>
    <div class="container mx-auto max-w-screen-xl px-7 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-[250px_auto] gap-6">
            <!-- Table of Contents -->
            <nav class="hidden lg:block sticky top-8 self-start max-h-[calc(100vh-120px)]">
                <div class="rounded-lg p-4 h-full max-h-[calc(100vh-120px)] flex flex-col">
                    <h2 class="text-lg font-bold mb-3 text-pacamara-dark dark:text-white flex-shrink-0">Career Timeline</h2>
                    <div class="overflow-y-auto toc-scrollbar flex-grow">
                        <ul class="space-y-0.5 text-sm pr-2" id="toc">
                            {careers.map((item, index) => (
                                <li>
                                    <a 
                                        href={`#career-${index}`}
                                        class="block py-2 px-3 rounded-lg hover:bg-pacamara-accent/10 hover:text-pacamara-accent transition-all duration-300 text-pacamara-primary/70 dark:text-white/70"
                                        data-index={index}
                                    >
                                        <span class="font-medium">{item.data.title}</span>
                                        <span class="block text-xs opacity-75 mt-0.5">{item.data.company}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Career Timeline -->
            <div class="space-y-8">
                {careers.map((item, index) => (
                    <div id={`career-${index}`} class="scroll-mt-8 border-l-2 border-pacamara-accent/20 pl-6 transition-all duration-300">
                        <div class="flex flex-col md:flex-row justify-between mb-2">
                            <h3 class="text-xl font-bold text-pacamara-dark dark:text-white">
                                {item.data.title}
                            </h3>
                            <span class="text-pacamara-secondary text-sm">
                                {formatDate(item.data.startDate)} - 
                                {item.data.endDate ? formatDate(item.data.endDate) : 'Present'}
                            </span>
                        </div>
                        <h4 class="text-base text-pacamara-accent mb-3">
                            {item.data.company} • {item.data.location}
                        </h4>
                        <ul class="list-disc list-inside space-y-1.5 text-pacamara-primary/70 dark:text-white/70">
                            {item.data.description.map(desc => (
                                <li>{desc}</li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>
    </div>
</Base>

<style>
    .toc-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: theme('colors.pacamara-accent/30') transparent;
    }

    .toc-scrollbar::-webkit-scrollbar {
        width: 3px;
    }

    .toc-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .toc-scrollbar::-webkit-scrollbar-thumb {
        background-color: theme('colors.pacamara-accent/30');
        border-radius: 20px;
    }

    /* Active state for TOC items */
    .toc-active {
        @apply bg-pacamara-accent/10 text-pacamara-accent;
    }
</style>

<script>
// Intersection Observer for active TOC item
const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            document.querySelectorAll('#toc a').forEach(link => {
                link.classList.remove('toc-active');
            });
            const id = entry.target.id;
            const link = document.querySelector(`#toc a[href="#${id}"]`);
            if (link) {
                link.classList.add('toc-active');
                // Scroll the link into view within the TOC container
                const tocContainer = document.querySelector('.toc-scrollbar');
                if (tocContainer) {
                    const linkTop = link.offsetTop;
                    const containerHeight = tocContainer.clientHeight;
                    const scrollOffset = linkTop - containerHeight / 2;
                    tocContainer.scrollTo({
                        top: scrollOffset,
                        behavior: 'smooth'
                    });
                }
            }
        }
    });
}, {
    rootMargin: '-50% 0px -50% 0px',
    threshold: 0
});

document.querySelectorAll('[id^="career-"]').forEach((section) => {
    observer.observe(section);
});

// Smooth scroll for TOC links
document.querySelectorAll('#toc a').forEach(link => {
    link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = link.getAttribute('href');
        document.querySelector(href)?.scrollIntoView({
            behavior: 'smooth'
        });
    });
});
</script> 