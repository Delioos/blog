---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets'
import Base from "../../layouts/Base.astro";
import AuthorInfo from "../../components/blog/AuthorInfo.astro";
import LatestPosts from "../../components/blog/LatestPosts.astro";
import PublishDate from "../../components/blog/PublishDate.astro";
import Tag from "../../components/general/Tag.astro";
import { getCollection, getEntry } from "astro:content";

// This runs at build time
export async function getStaticPaths() {
    const blogEntries = await getCollection("blog");
    return blogEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

// Get the entry from props
const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };

// Ensure entry exists before rendering
if (!entry) {
    return Astro.redirect('/404');
}

// Now we can safely render the content
const { Content } = await entry.render();

// Get author data
const author = entry.data.author ? await getEntry(entry.data.author) : null;

const postData = {
    data: {
        title: "Blog",
        description: "All blog posts"
    }
};
---

<Base postData={postData}>
    <article class="container mx-auto max-w-screen-lg px-7 py-10">
        <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
        <div class="flex items-center gap-4 mb-8">
            {author && <AuthorInfo authorData={author} />}
            <PublishDate date={entry.data.pubDate} />
            <Tag tags={entry.data.tag} />
        </div>
        <div class="prose max-w-none
            prose-headings:font-bold prose-headings:text-pacamara-accent 
            prose-p:text-pacamara-primary/70 lg:prose-p:text-[18px] prose-p:transition-all prose-p:duration-300 
            prose-a:font-semibold prose-a:text-pacamara-dark prose-a:hover:text-pacamara-accent prose-a:no-underline prose-a:transition-all prose-a:duration-300
            prose-strong:font-normal 
            prose-headings:font-pacamara-space prose-h2:mb-7
            dark:prose-a:text-white dark:prose-a:hover:text-pacamara-accent dark:prose-p:text-white/70
            dark:prose-li:text-white/70
            ">
            <Content />
        </div>
    </article>
    <LatestPosts skipPost={entry.data.title} />
</Base>
