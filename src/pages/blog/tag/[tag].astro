---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Post from "../../../components/blog/Post.astro";
import TagList from "../../../components/blog/TagList.astro";

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    
    // Get all valid posts with tags
    const validPosts = posts.filter(post => 
        post.data.tag && 
        Array.isArray(post.data.tag) && 
        post.data.tag.length > 0
    );
    
    // Get unique tags, normalized to lowercase
    const tags = [...new Set(validPosts.flatMap(post => 
        post.data.tag.map(t => t.toLowerCase())
    ))];
    
    const paths = tags.map(tag => {
        const filteredPosts = validPosts.filter(post => 
            post.data.tag.some(t => t.toLowerCase() === tag.toLowerCase())
        ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
        
        return {
            params: { tag: tag.toLowerCase() },
            props: {
                posts: filteredPosts,
                tag
            }
        };
    });
    
    return paths;
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const postData = {
    data: {
        title: `Posts tagged "${tag}"`,
        description: `All blog posts tagged with ${tag}`
    }
};
---

<Base postData={postData}>
    <section class="container mx-auto max-w-screen-xl px-6 py-16">
        <!-- Metadata section -->
        <div class="border-t border-brutal-gray pt-6 mb-12">
            <div class="flex flex-wrap gap-x-12 gap-y-2 font-mono text-brutal-meta text-brutal-dark dark:text-brutal-white">
                <span>TYPE: Tag Filter</span>
                <span>TAG: {tag.toUpperCase()}</span>
                <span>POSTS: {posts?.length || 0}</span>
                <span>STATUS: Filtered</span>
            </div>
        </div>
        
        <!-- Main title -->
        <h1 class="text-brutal-title font-black text-brutal-black dark:text-brutal-white mb-16 leading-none">
            #{tag.toUpperCase()}
        </h1>
        
        <!-- Tag list -->
        <div class="mb-16">
            <TagList activeTag={tag} />
        </div>
        
        <!-- Posts list -->
        <div class="max-w-4xl">
            {posts && posts.length > 0 ? (
                posts.map((post, index) => (
                    <Post postData={post} num={index} />
                ))
            ) : (
                <div class="text-center py-16">
                    <p class="text-brutal-content text-brutal-dark dark:text-brutal-white font-serif">
                        No posts found for tag "{tag.toUpperCase()}"
                    </p>
                </div>
            )}
        </div>
    </section>
</Base> 