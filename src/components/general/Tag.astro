---
const { tags } = Astro.props;
---
{tags && tags.length > 0 && 
    <div class="flex flex-row gap-2 flex-wrap">
        {tags.map((tag: string) => (
            <a 
                href={`/blog/tag/${tag.toLowerCase()}`}
                class="pill-button text-xs"
            >
                {tag}
            </a>
        ))}
    </div>
}