---
import { Image } from 'astro:assets'
import logoImage from '../../assets/authors/delioos.jpg';
---

<!-- Main title section with brutalist styling -->
<section class="container mx-auto max-w-screen-xl px-6 pt-20 pb-16">
    <!-- Metadata section with monospace formatting -->
    <div class="border-t border-brutal-gray pt-6 mb-12">
        <div class="flex flex-wrap gap-x-12 gap-y-2 font-mono text-brutal-meta text-brutal-dark dark:text-brutal-white">
            <span>ROLE: Low-level developer</span>
            <span>STACK: Rust, Huff, Yul</span>
            <span>FOCUS: Market-making</span>
            <span>AGE: 21</span>
            <span>STATUS: Building</span>
        </div>
    </div>
    
    <!-- Main title with brutalist typography -->
    <h1 class="text-brutal-title font-black text-brutal-black dark:text-brutal-white mb-8 max-w-4xl">
        Digital adventurer decoding the future at the intersection of code, crypto, and human potential
    </h1>
    
    <!-- Author image -->
    <div class="mb-8">
        <Image 
            src={logoImage} 
            width={200} 
            alt="Delioos" 
            loading="eager" 
            decoding="sync" 
            class="w-32 h-32 rounded-none border-2 border-brutal-black dark:border-brutal-white object-cover"  
        />
    </div>
    
    <!-- Content paragraph -->
    <div class="max-w-2xl">
        <p class="text-brutal-content text-brutal-dark dark:text-brutal-white font-serif leading-relaxed">
            Follow the journey of a 22-year-old developer exploring the depths of low-level programming, 
            blockchain technology, and market dynamics. Building with Rust, Huff, and Yul while 
            deciphering the future of decentralized systems.
        </p>
    </div>
</section>

