---
import Facebook from '../icons/facebook.astro';
import Github from '../icons/github.astro';
import Instagram from '../icons/instagram.astro';
import Pinterest from '../icons/pinterest.astro';
import Twitter from '../icons/twitter.astro';
import Messenger from '../icons/messenger.astro';
import Dribbble from '../icons/dribbble.astro';
import Mastodon from '../icons/mastodon.astro';
import Skype from '../icons/skype.astro';

type SocialType = 'github' | 'twitter' | 'facebook' | 'instagram' | 'pinterest' | 'messenger' | 'dribbble' | 'mastodon' | 'skype';

const { socialUrl = false, socialType } = Astro.props;

// Map social types to their components
const socialComponents: Record<SocialType, any> = {
  github: Github,
  twitter: Twitter,
  facebook: Facebook,
  instagram: Instagram,
  pinterest: Pinterest,
  messenger: Messenger,
  dribbble: Dribbble,
  mastodon: Mastodon,
  skype: Skype
};

const SocialComponent = socialComponents[socialType as SocialType];
---

{socialUrl && (
  <li>
    <a 
      href={socialUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      aria-label={`${socialType} link`}
    >
      <SocialComponent />
    </a>
  </li>
)}