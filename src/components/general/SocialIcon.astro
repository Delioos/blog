---
// Import all icon components
import Facebook from '../icons/facebook.astro';
import Github from '../icons/github.astro';
import Twitter from '../icons/twitter.astro';
import Instagram from '../icons/instagram.astro';
import Mastodon from '../icons/mastodon.astro';
import Pinterest from '../icons/pinterest.astro';
import Skype from '../icons/skype.astro';
import Dribbble from '../icons/dribbble.astro';

type SocialType = 'github' | 'twitter' | 'facebook' | 'instagram' | 'mastodon' | 'pinterest' | 'skype' | 'dribbble';

const { socialUrl=false, socialType } = Astro.props;

const icons: Record<SocialType, any> = {
  github: Github,
  twitter: Twitter,
  facebook: Facebook,
  instagram: Instagram,
  mastodon: Mastodon,
  pinterest: Pinterest,
  skype: Skype,
  dribbble: Dribbble
}

const Icon = icons[socialType as SocialType];
---
{socialUrl &&
<li>
    <a href={socialUrl} target="_blank" rel="noopener noreferrer" aria-label={socialType + " link"}>
        <Icon />
    </a>
</li>
}