---
const { postData, num } = Astro.props;
import { Image } from 'astro:assets'
import PublishDate from "./PublishDate.astro";
import Tag from "../general/Tag.astro";
// default image if no image added
import defaultImage from "../../assets/default.jpg";

const isOdd = num % 2;
---
<article class="group mb-6 last:mb-0 pb-6 border-b border-gray-200 dark:border-gray-700 group-last:border-b-0">
    <div class="space-y-3">
        <h3 class="text-xl font-bold">
            <a href={ '/blog/' + postData.slug } class="text-pacamara-dark hover:text-pacamara-accent dark:text-white dark:hover:text-pacamara-accent transition-colors">
                { postData.data.title }
            </a>
        </h3>
        
        <p class="text-pacamara-primary/70 dark:text-white/70 text-sm leading-relaxed">
            { postData.data.intro }
        </p>
        
        <div class="flex flex-row flex-wrap gap-3 items-center text-sm">
            <Tag tags={postData.data.tag} />
            <PublishDate date={postData.data.pubDate} />
        </div>
    </div>
</article>
