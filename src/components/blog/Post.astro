---
const { postData, num } = Astro.props;
import { Image } from 'astro:assets'
import PublishDate from "./PublishDate.astro";
import Tag from "../general/Tag.astro";
// default image if no image added
import defaultImage from "../../assets/default.jpg";

const isOdd = num % 2;
---
<article class="group mb-8 last:mb-0 pb-8 border-b border-brutal-gray dark:border-brutal-gray last:border-b-0">
    <div class="space-y-4">
        <h3 class="text-2xl font-black leading-tight">
            <a href={ '/blog/' + postData.slug } class="text-brutal-black hover:underline dark:text-brutal-white transition-all duration-200">
                { postData.data.title }
            </a>
        </h3>
        
        <p class="text-brutal-content text-brutal-dark dark:text-brutal-white leading-relaxed font-serif">
            { postData.data.intro }
        </p>
        
        <div class="flex flex-row flex-wrap gap-4 items-center">
            <Tag tags={postData.data.tag} />
            <PublishDate date={postData.data.pubDate} />
        </div>
    </div>
</article>
