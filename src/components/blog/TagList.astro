---
import { getCollection } from 'astro:content';

// Get all unique tags from blog posts
const posts = await getCollection('blog');
const tags = [...new Set(posts
    .filter(post => post.data.tag && Array.isArray(post.data.tag))
    .flatMap(post => post.data.tag.map(t => t.toLowerCase()))
)].sort();

const { activeTag } = Astro.props;
---
<div class="flex flex-wrap gap-3 mb-8">
    <a 
        href="/blog"
        class={`text-[16px] border-[1px] leading-none rounded-full py-3 px-5 transition-all duration-300
        ${!activeTag 
            ? 'bg-pacamara-accent text-white border-pacamara-accent' 
            : 'bg-transparent border-pacamara-secondary text-pacamara-secondary hover:bg-pacamara-accent hover:text-white hover:border-pacamara-accent'
        }`}
    >
        All
    </a>
    {tags.map(tag => (
        <a 
            href={`/blog/tag/${tag.toLowerCase()}`}
            class={`text-[16px] border-[1px] leading-none rounded-full py-3 px-5 transition-all duration-300
            ${activeTag?.toLowerCase() === tag.toLowerCase()
                ? 'bg-pacamara-accent text-white border-pacamara-accent'
                : 'bg-transparent border-pacamara-secondary text-pacamara-secondary hover:bg-pacamara-accent hover:text-white hover:border-pacamara-accent'
            }`}
        >
            {tag}
        </a>
    ))}
</div> 