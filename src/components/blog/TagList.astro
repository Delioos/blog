---
import { getCollection } from 'astro:content';

// Get all unique tags from blog posts
const posts = await getCollection('blog');
const tags = [...new Set(posts
    .filter(post => post.data.tag && Array.isArray(post.data.tag))
    .flatMap(post => post.data.tag.map(t => t.toLowerCase()))
)].sort();

const { activeTag } = Astro.props;
---
<div class="mb-8">
    <h3 class="font-mono text-brutal-meta text-brutal-dark dark:text-brutal-white mb-6">FILTER BY TAG:</h3>
    <div class="flex flex-wrap gap-3">
        <a 
            href="/blog"
            class={`pill-button text-xs ${!activeTag 
                ? 'active' 
                : ''
            }`}
        >
            ALL
        </a>
        {tags.map(tag => (
            <a 
                href={`/blog/tag/${tag.toLowerCase()}`}
                class={`pill-button text-xs ${activeTag?.toLowerCase() === tag.toLowerCase()
                    ? 'active'
                    : ''
                }`}
            >
                {tag.toUpperCase()}
            </a>
        ))}
    </div>
</div> 