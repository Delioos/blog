---
const { tags } = Astro.props;
---
{tags && tags.length > 0 && 
    <div class="flex flex-row gap-2 flex-wrap">
        {tags.map((tag: string) => (
            <span class="
                inline-block 
                px-3 py-1 
                border-2 border-brutal-black dark:border-brutal-white 
                bg-brutal-white dark:bg-brutal-black 
                font-mono text-xs 
                text-brutal-black dark:text-brutal-white 
                uppercase 
                letter-spacing-wide
            ">
                {tag.toUpperCase()}
            </span>
        ))}
    </div>
}