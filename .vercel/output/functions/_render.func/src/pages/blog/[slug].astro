---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets'
import Base from "../../layouts/Base.astro";
import AuthorInfo from "../../components/blog/AuthorInfo.astro";
import LatestPosts from "../../components/blog/LatestPosts.astro";
import PublishDate from "../../components/blog/PublishDate.astro";
import Tag from "../../components/general/Tag.astro";
import { getCollection, getEntry } from "astro:content";

// This runs at build time
export async function getStaticPaths() {
    const blogEntries = await getCollection("blog");
    return blogEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

// Get the entry from props
const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };

// Ensure entry exists before rendering
if (!entry) {
    return Astro.redirect('/404');
}

// Now we can safely render the content
const { Content } = await entry.render();

// Get author data
const author = entry.data.author ? await getEntry(entry.data.author) : null;
---

<Base postData={entry}>
    <article class="container mx-auto max-w-screen-lg px-7 py-10">
        <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
        <div class="flex items-center gap-4 mb-8">
            {author && <AuthorInfo authorData={author} />}
            <PublishDate date={entry.data.pubDate} />
            <Tag tags={entry.data.tag} />
        </div>
        <div class="prose max-w-none">
            <Content />
        </div>
    </article>
    <LatestPosts skipPost={entry.data.title} />
</Base>
